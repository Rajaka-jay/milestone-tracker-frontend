# Base URL of the Express backend (no trailing slash).
VITE_API_URL=http://localhost:4000/api

# true  = run against the built-in in-browser mock backend (no server needed)
# false = call the real REST API at VITE_API_URL
VITE_USE_MOCK=false

# Optional: "hash" uses #/routes (handy for static hosting without SPA fallback)
# VITE_ROUTER_MODE=hash
